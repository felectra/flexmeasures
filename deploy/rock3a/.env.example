# ------------------------------------------------------------------
# Copy this file to deploy/rock3a/.env and replace every CHANGE_ME value.
# The real .env is git-ignored — it must never be committed.
#
# Generate strong values on the board (Python 3 is preinstalled on Armbian):
#   SECRET_KEY:               python3 -c "import secrets; print(secrets.token_urlsafe())"
#   TOTP secret (hex):        python3 -c "import secrets; print(secrets.token_hex(24))"
#   DB / Redis passwords:     python3 -c "import secrets; print(secrets.token_hex(16))"
# ------------------------------------------------------------------

# --- Postgres (the values below are interpolated into SQLALCHEMY_DATABASE_URI) ---
POSTGRES_DB=fm_pilot
POSTGRES_USER=fm_pilot
POSTGRES_PASSWORD=CHANGE_ME_db_password

# --- Redis (job queue) ---
FLEXMEASURES_REDIS_PASSWORD=CHANGE_ME_redis_password

# --- FlexMeasures security (both are required) ---
SECRET_KEY=CHANGE_ME_secret_key
# SECURITY_TOTP_SECRETS must stay valid JSON. Keep the "1" key; add more later without removing old ones.
SECURITY_TOTP_SECRETS={"1":"CHANGE_ME_totp_secret"}
