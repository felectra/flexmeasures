# ------------------------------------------------------------------
# Copy this file to deploy/rock3a/.env and replace every CHANGE_ME value.
# The real .env is git-ignored — it must never be committed.
#
# Generate strong values on the board (Python 3 is preinstalled on Armbian):
#   SECRET_KEY:               python3 -c "import secrets; print(secrets.token_urlsafe(48))"
#   TOTP secret (hex):        python3 -c "import secrets; print(secrets.token_hex(24))"
#   DB / Redis passwords:     python3 -c "import secrets; print(secrets.token_hex(16))"
# ------------------------------------------------------------------

# --- Postgres (the values below are interpolated into SQLALCHEMY_DATABASE_URI) ---
POSTGRES_DB=fm_pilot
POSTGRES_USER=fm_pilot
POSTGRES_PASSWORD=CHANGE_ME_db_password

# --- Redis (job queue) ---
FLEXMEASURES_REDIS_PASSWORD=CHANGE_ME_redis_password

# --- FlexMeasures security (both are required) ---
SECRET_KEY=CHANGE_ME_secret_key
# SECURITY_TOTP_SECRETS must stay valid JSON. Keep the "1" key; add more later without removing old ones.
SECURITY_TOTP_SECRETS={"1":"CHANGE_ME_totp_secret"}

# --- Network exposure ---
# Publish the UI/API and MailHog only on this host interface — the board's Tailscale IP,
# so they are reachable over the tailnet but not on the office LAN/Wi-Fi.
# Use 127.0.0.1 for loopback-only (reach it through an SSH tunnel).
BIND_ADDR=100.75.41.122
# Hosts FlexMeasures trusts in the Host header (comma-separated). Include every name/address
# you actually reach the server by — the Tailscale IP here, and the MagicDNS name if you use one.
# Without a match, production rejects the request (Host-header poisoning protection).
TRUSTED_HOSTS=127.0.0.1,localhost,100.75.41.122

# --- Dashboard map (optional) ---
# Public Mapbox access token (pk.*) that renders the map on the dashboard and asset pages.
# Get one free at https://account.mapbox.com/access-tokens/. Leave empty to disable the map.
MAPBOX_ACCESS_TOKEN=
